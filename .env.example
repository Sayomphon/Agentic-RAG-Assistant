# Required
OPENAI_API_KEY=your-key-here

# Optional model configuration
MODEL_NAME=gpt-5-mini
TEMPERATURE=0

# Optional retrieval configuration
# Copying this file activates the versioned Track A profile. Without a .env
# file, runtime code remains on the offline-safe "keyword_safe" profile.
RETRIEVAL_PROFILE=track_a_balanced_v1
KB_PATH=knowledge_base.txt
# Named-profile values can be overridden individually when required.
# TOP_K=6
# CANDIDATE_K=12
MIN_SCORE=2.0
MIN_MATCHED_TERMS=2
MIN_RELATIVE_SCORE=0.55
TITLE_BOOST=1.5
THAI_TOKENIZER_ENABLED=true
# SEARCH_MODE=hybrid
MAX_SEARCH_ATTEMPTS=3

# Optional dense/hybrid retrieval configuration (SEARCH_MODE=semantic|hybrid)
EMBEDDING_MODEL=text-embedding-3-small
MIN_COSINE=0.38
# HYBRID_MIN_COSINE=0.20
EMBEDDING_CACHE_DIR=.cache
FUSION_METHOD=rrf
RRF_K=60
DENSE_WEIGHT=0.5

# Optional local reranking (applied to hybrid mode)
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=b4019bcd5cae485c342f61fe5889c2c800c5abec
RERANKER_CACHE_DIR=.cache/reranker
RERANKER_DEVICE=
# RERANKER_BATCH_SIZE=4
# RERANKER_TIMEOUT_SECONDS=10
RERANKER_MAX_CANDIDATES=30
# RERANKER_MAX_LENGTH is supplied by the named profile (v1=512, v2=128).
# RERANKER_MAX_LENGTH=512
# Use "off" only for an explicit lab experiment.
# RERANKER_MIN_SCORE=0.01
RERANKER_LOCAL_FILES_ONLY=false
RERANKER_FAILURE_POLICY=fail_closed
# v2 keeps Secondary as an emergency path for low-risk, single-section intent.
# RERANKER_SECONDARY_POLICY=emergency_low_risk_only

# Secondary local reranker (loaded only on warmup or primary failure)
RERANKER_FALLBACK_ENABLED=true
RERANKER_FALLBACK_MODEL=BAAI/bge-reranker-base
RERANKER_FALLBACK_MODEL_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
RERANKER_FALLBACK_CACHE_DIR=.cache/reranker-fallback
RERANKER_FALLBACK_MAX_LENGTH=512
# Secondary score semantics are independent from the primary model.
RERANKER_FALLBACK_MIN_SCORE=0.01

# Optional grounding-context controls
# MAX_CONTEXT_CHARS=6000
CONTEXT_DUPLICATE_THRESHOLD=0.90
CONTEXT_MIN_BODY_CHARS=80
